{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DAMDesk",
  "version": "0.1.0",
  "identifier": "com.soujpg.dam.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5180",
    "beforeBuildCommand": "pnpm build",
    "beforeBundleCommand": "bash scripts/pack_runtime_gate.sh",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "resources": {
      "resources/models/siglip2-base-p224-onnx/**/*": "models/siglip2-base-p224-onnx/",
      "resources/models/u2net/**/*": "models/u2net/",
      "resources/models/realesr-general-x4v3/**/*": "models/realesr-general-x4v3/",
      "resources/models/ppocrv6-medium-det/**/*": "models/ppocrv6-medium-det/",
      "resources/models/ppocrv6-medium-rec/**/*": "models/ppocrv6-medium-rec/",
      "../../web/dist/assets/**/*": "web-dist/assets/",
      "../../web/dist/index.html": "web-dist/index.html",
      "resources/runtime": "runtime",
      "resources/pack-launcher": "pack-launcher"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
