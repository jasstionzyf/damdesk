# dam-desktop dev environment
# Build:  docker compose -f dev/docker-compose.yml build   (uses host network so 127.0.0.1:11700 proxy works)
# Run:    docker compose -f dev/docker-compose.yml up -d
# Shell:  docker compose -f dev/docker-compose.yml exec dam-dev bash

services:
  dam-dev:
    build:
      context: .
      dockerfile: Dockerfile
      network: host # build-time proxy is 127.0.0.1 on the host
      args:
        # 构建期走宿主网络，代理 = gpu7 本机 127.0.0.1:11700（gpu0 已下线，2026-10-16 切换）
        HTTP_PROXY: http://127.0.0.1:11700
        HTTPS_PROXY: http://127.0.0.1:11700
        NO_PROXY: 127.0.0.1,localhost,172.16.0.0/12,10.0.0.0/8,192.168.0.0/16
    image: soujpg-dam-desktop-dev:latest
    container_name: dam-dev
    command: sleep infinity
    init: true
    # repo bind mount (compose file lives in dev/, repo root is ..)
    volumes:
      - ..:/workspace
      # NVMe-backed named volumes — /data host disk is HDD, no build artifacts there
      - dam_cargo_target:/cargo-target
      - dam_cargo_registry:/cargo # copies image's cargo shims on first use
      - dam_pnpm_store:/pnpm-store
      # 真实模型文件（siglip2-base-p224-onnx 等，宿主机一次下载，容器只读挂载）
      # 宿主：/data1/dam-models；测试用 DAM_TEST_MODELS 指到具体模型目录
      - /data1/dam-models:/models:ro
    extra_hosts:
      - "host.docker.internal:host-gateway"
    environment:
      # 运行期容器内代理指向 gpu7 宿主（docker0 网关）；gpu0 已下线（2026-10-16 切换）
      HTTP_PROXY: http://172.17.0.1:11700
      HTTPS_PROXY: http://172.17.0.1:11700
      NO_PROXY: 127.0.0.1,localhost,172.16.0.0/12,10.0.0.0/8,192.168.0.0/16
      # cargo/git must NOT go through proxy for Gitea (intranet)
      CARGO_NET_GIT_FETCH_WITH_CLI: "true"
      # 真实 ONNX 模型目录（真实推理单测用；无此目录时相关测试显式失败）
      DAM_TEST_MODELS: /models/siglip2-base-p224-onnx
      # D5：去重向量模型（DINOv3 ViT-S/16，仅 image，384 维）
      DAM_TEST_MODELS_DEDUP: /models/dinov3-vits16
    cap_add:
      - SYS_ADMIN # xvfb-run needs it
    shm_size: "1gb"

volumes:
  dam_cargo_target:
  dam_cargo_registry:
  dam_pnpm_store:
